# Optional: enables OpenAI-powered investigation. Leave blank to use deterministic fallback.
OPENAI_API_KEY=

# Optional: Razorpay Test Mode read/verify integration.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Required for signed human approval grants when human-gated recovery is enabled.
PAYGUARD_APPROVAL_SECRET=replace_with_a_long_random_secret
